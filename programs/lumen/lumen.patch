+            if (!e->stun) {
+                int sp = lit ? (170 - (s * 140 >> 8) > 30 ? 170 - (s * 140 >> 8) : 30) : 330, wob = SIN(e->ph) >> 3;
+                int vx = (ux * sp >> 8) + (-uy * wob >> 8), vy = (uy * sp >> 8) + (ux * wob >> 8);
