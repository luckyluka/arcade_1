+            for (int q = 1; q < 7; q++) { int dx = e->sx[q] - px, dy = e->sy[q] - py, dd = (int)(isqrt((unsigned)((dx >> 4) * (dx >> 4) + (dy >> 4) * (dy >> 4))) << 4); if (!dd) dd = 1;
