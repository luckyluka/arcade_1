diff --git a/tests/test_lumen.sh b/tests/test_lumen.sh
new file mode 100755
index 0000000..ddb95ac
--- /dev/null
+++ b/tests/test_lumen.sh
@@ -0,0 +1,98 @@
+#!/bin/sh
+# ARCADE-1 - lumen test (the dark-room adventure whose light is your tap speed).
+# A scripted session (tests/inputs/lumen.txt, generated closed-loop against this ROM)
+# plays the title, starts, charges light with A/B alternation, releases it, crosses
+# room 1 tapping fast, takes the key and runs through the door into room 2.
+#
+# The assertions are made through the game's named variables:
+#   1. determinism   - two identical sessions, identical output
+#   2. the story     - title, play, charge fills and is released, tap meter fills,
+#                      the key is taken, room 2 is reached, something is killed,
+#                      and the display list stays inside its budget
+#   3. record->replay - the recorded session replays bit-identically
+#   4. budget        - the heaviest sampled frame stays under half the instruction cap
+#
+# usage: test_lumen.sh <arcade1-cli> <rom-dir> <golden-dir>
+
+set -eu
+
+CLI=${1:?usage: test_lumen.sh <arcade1-cli> <rom-dir> <golden-dir>}
+ROM=${2:?}
+
+OUT=$(mktemp -d)
+trap 'rm -rf "$OUT"' EXIT
+
+fail() { echo "test-lumen: FAILED - $1" >&2; exit 1; }
+note() { echo "  $1"; }
+
+GAME=$ROM/lumen.arc1
+[ -x "$CLI" ]  || fail "CLI not built at $CLI"
+[ -f "$GAME" ] || fail "missing $GAME"
+SCRIPT=$(dirname "$0")/inputs/lumen.txt
+[ -f "$SCRIPT" ] || fail "missing $SCRIPT"
+
+FRAMES=880
+SYMS=$ROM/lumen.syms
+if [ ! -f "$SYMS" ] && [ -f "$ROM/lumen.elf" ] &&
+   command -v riscv64-unknown-elf-nm >/dev/null 2>&1; then
+    riscv64-unknown-elf-nm "$ROM/lumen.elf" > "$OUT/lumen.syms"
+    SYMS="$OUT/lumen.syms"
+fi
+
+has() { grep -qE "^vars +[0-9]+( .*)? $1=$2( |$)" "$OUT/trace.txt"; }
+
+if [ -f "$SYMS" ]; then
+    # --- 1) determinism ----------------------------------------------------
+    "$CLI" run "$GAME" --frames 600 --input "$SCRIPT" --syms "$SYMS" \
+        --vars score,state,hero_x --quiet > "$OUT/r1.txt" 2>/dev/null
+    "$CLI" run "$GAME" --frames 600 --input "$SCRIPT" --syms "$SYMS" \
+        --vars score,state,hero_x --quiet > "$OUT/r2.txt" 2>/dev/null
+    if ! cmp -s "$OUT/r1.txt" "$OUT/r2.txt"; then
+        diff "$OUT/r1.txt" "$OUT/r2.txt" | head -5 >&2
+        fail "two identical sessions produced different output"
+    fi
+    note "determinism ok - two 600-frame sessions identical"
+
+    # --- 2) the story ------------------------------------------------------
+    "$CLI" run "$GAME" --frames $FRAMES --input "$SCRIPT" --syms "$SYMS" \
+        --vars state,room,hp,haskey,kills,tap_speed,charge,dl_n --var-every 10 \
+        > "$OUT/main.txt" 2>/dev/null
+    cat "$OUT/main.txt"
+    grep '^vars' "$OUT/main.txt" > "$OUT/trace.txt"
+
+    has state 0 || fail "the session should open on the title screen"
+    has state 1 || fail "the session should start playing after A"
+    has tap_speed 256 || fail "tapping every 4 frames should fill the tap-speed meter"
+    awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^charge=/) { v = substr($i, 8) + 0; if (prev >= 20000 && v == 0) ok = 1; prev = v } }
+         END { exit ok ? 0 : 1 }' "$OUT/trace.txt" ||
+        fail "alternating A/B should fill the charge meter and START should spend it"
+    has haskey 1 || fail "the key should be taken"
+    has room 1   || fail "the run should reach room 2 through the door"
+    grep -qE '^vars +[0-9]+ .*kills=[1-9]' "$OUT/trace.txt" || fail "the sword should kill something"
+    MAXDL=$(grep -oE 'dl_n=[0-9]+' "$OUT/trace.txt" | cut -d= -f2 | sort -n | tail -1)
+    [ "$MAXDL" -le 900 ] || fail "the display list overflowed its 900-segment capacity ($MAXDL)"
+    note "story ok - title, play, charge+release, key, room 2, kills; display list peak $MAXDL segments"
+
+    # --- 3) record -> replay ----------------------------------------------
+    "$CLI" run "$GAME" --frames 700 --input "$SCRIPT" --record "$OUT/rec.txt" --quiet > /dev/null 2>&1
+    "$CLI" run "$GAME" --frames 700 --input "$OUT/rec.txt" --syms "$SYMS" --vars score,state > "$OUT/re.txt" 2>/dev/null
+    "$CLI" run "$GAME" --frames 700 --input "$SCRIPT" --syms "$SYMS" --vars score,state > "$OUT/main.f0" 2>/dev/null
+    grep '^frame ' "$OUT/main.f0" > "$OUT/main.f"
+    grep '^frame ' "$OUT/re.txt"  > "$OUT/re.f"
+    cmp -s "$OUT/main.f" "$OUT/re.f" || fail "the recorded session does not replay bit-identically"
+    note "record->replay ok"
+else
+    note "named variables skipped - no lumen.syms and no riscv nm to make one"
+fi
+
+# --- 4) instruction budget: heaviest sampled frame under half the cap ------
+MAX=0
+for f in 60 200 400 600 800 870; do
+    N=$("$CLI" inspect "$GAME" --frames $f --input "$SCRIPT" 2>/dev/null | awk '$1=="INSTRET_FRAME"{print $2}')
+    [ -n "$N" ] || fail "inspect gave no INSTRET_FRAME at frame $f"
+    [ "$N" -gt "$MAX" ] && MAX=$N
+done
+[ "$MAX" -lt 500000 ] || fail "a frame retired $MAX instructions (budget 500000 of the 1000000 cap)"
+note "budget ok - heaviest sampled frame $MAX instructions"
+
+echo "test-lumen: lumen ok (determinism, story, record-replay, budget)"
