diff --git a/tests/test_tapracer.sh b/tests/test_tapracer.sh
new file mode 100755
index 0000000..729b026
--- /dev/null
+++ b/tests/test_tapracer.sh
@@ -0,0 +1,110 @@
+#!/bin/sh
+# ARCADE-1 - tapracer test (the neon pseudo-3D racer whose throttle is your tap speed).
+# Two scripted sessions, both generated closed-loop against this ROM (they steer back to the lane centre):
+#   tests/inputs/tapracer.txt       taps A every 5 frames, charges with A/B alternation, boosts with START
+#   tests/inputs/tapracer_idle.txt  only steers, never taps
+#
+# The assertions are made through the game's named variables:
+#   1. determinism   - two identical sessions, identical output
+#   2. the story     - title, countdown, race, finish; the tap meter fills; the charge fills and is spent
+#                      into a boost; the car reaches top speed; the lap is finished; the display list fits
+#   3. tier ordering - the same 1800 frames: the tapping session finishes, the idle one does not and is behind
+#   4. record->replay - the recorded session replays bit-identically
+#   5. budget        - the heaviest sampled frame stays under half the instruction cap
+#
+# usage: test_tapracer.sh <arcade1-cli> <rom-dir> <golden-dir>
+
+set -eu
+
+CLI=${1:?usage: test_tapracer.sh <arcade1-cli> <rom-dir> <golden-dir>}
+ROM=${2:?}
+
+OUT=$(mktemp -d)
+trap 'rm -rf "$OUT"' EXIT
+
+fail() { echo "test-tapracer: FAILED - $1" >&2; exit 1; }
+note() { echo "  $1"; }
+
+GAME=$ROM/tapracer.arc1
+[ -x "$CLI" ]  || fail "CLI not built at $CLI"
+[ -f "$GAME" ] || fail "missing $GAME"
+TAP=$(dirname "$0")/inputs/tapracer.txt
+IDLE=$(dirname "$0")/inputs/tapracer_idle.txt
+[ -f "$TAP" ] && [ -f "$IDLE" ] || fail "missing input scripts"
+
+FRAMES=1800
+SYMS=$ROM/tapracer.syms
+if [ ! -f "$SYMS" ] && [ -f "$ROM/tapracer.elf" ] &&
+   command -v riscv64-unknown-elf-nm >/dev/null 2>&1; then
+    riscv64-unknown-elf-nm "$ROM/tapracer.elf" > "$OUT/tapracer.syms"
+    SYMS="$OUT/tapracer.syms"
+fi
+
+has() { grep -qE "^vars +[0-9]+( .*)? $1=$2( |$)" "$OUT/trace.txt"; }
+
+if [ -f "$SYMS" ]; then
+    # --- 1) determinism ----------------------------------------------------
+    "$CLI" run "$GAME" --frames 500 --input "$TAP" --syms "$SYMS" --vars pz,mode --quiet > "$OUT/r1.txt" 2>/dev/null
+    "$CLI" run "$GAME" --frames 500 --input "$TAP" --syms "$SYMS" --vars pz,mode --quiet > "$OUT/r2.txt" 2>/dev/null
+    if ! cmp -s "$OUT/r1.txt" "$OUT/r2.txt"; then
+        diff "$OUT/r1.txt" "$OUT/r2.txt" | head -5 >&2
+        fail "two identical sessions produced different output"
+    fi
+    note "determinism ok - two 500-frame sessions identical"
+
+    # --- 2) the story ------------------------------------------------------
+    "$CLI" run "$GAME" --frames $FRAMES --input "$TAP" --syms "$SYMS" \
+        --vars mode,pz,sp,boost,charge,tap_speed,dl_n,fin,rank --var-every 10 > "$OUT/main.txt" 2>/dev/null
+    cat "$OUT/main.txt"
+    grep '^vars' "$OUT/main.txt" > "$OUT/trace.txt"
+
+    has mode 0 || fail "the session should open on the title screen"
+    has mode 1 || fail "pressing A should start the countdown"
+    has mode 2 || fail "the race should start after the countdown"
+    grep -qE ' tap_speed=2[3-5][0-9]( |$)' "$OUT/trace.txt" || fail "tapping every 5 frames should nearly fill the tap-speed meter (>= 230)"
+    awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^charge=/) { v = substr($i, 8) + 0; if (prev >= 15000 && v == 0) ok = 1; prev = v } }
+         END { exit ok ? 0 : 1 }' "$OUT/trace.txt" ||
+        fail "alternating A/B should fill the charge meter and START should spend it"
+    grep -qE ' boost=[1-9]' "$OUT/trace.txt" || fail "spending the charge should start a boost"
+    grep -qE ' sp=(2[0-9][0-9])( |$)' "$OUT/trace.txt" || fail "tap speed plus boost should reach top speed (sp >= 200)"
+    has mode 3 || fail "the lap should be finished inside $FRAMES frames"
+    FIN=$(grep -oE ' fin=[0-9]+' "$OUT/trace.txt" | tail -1 | cut -d= -f2)
+    [ "$FIN" -gt 0 ] && [ "$FIN" -lt 1700 ] || fail "finish time out of range ($FIN frames)"
+    RANK=$(grep -oE ' rank=[0-9]+' "$OUT/trace.txt" | tail -1 | cut -d= -f2)
+    [ "$RANK" -ge 1 ] && [ "$RANK" -le 4 ] || fail "finish rank out of range ($RANK)"
+    MAXDL=$(grep -oE 'dl_n=[0-9]+' "$OUT/trace.txt" | cut -d= -f2 | sort -n | tail -1)
+    [ "$MAXDL" -le 900 ] || fail "the display list overflowed its 900-segment capacity ($MAXDL)"
+    note "story ok - title, countdown, race, charge+boost, top speed, finish in $FIN frames (rank $RANK); display list peak $MAXDL"
+
+    # --- 3) tier ordering ---------------------------------------------------
+    "$CLI" run "$GAME" --frames $FRAMES --input "$IDLE" --syms "$SYMS" --vars mode,pz --quiet > "$OUT/idle.txt" 2>/dev/null
+    "$CLI" run "$GAME" --frames $FRAMES --input "$TAP" --syms "$SYMS" --vars mode,pz --quiet > "$OUT/tap.txt" 2>/dev/null
+    IM=$(awk '$2=="mode"{print $4}' "$OUT/idle.txt"); IZ=$(awk '$2=="pz"{print $4}' "$OUT/idle.txt")
+    TZ=$(awk '$2=="pz"{print $4}' "$OUT/tap.txt")
+    [ "$IM" = "2" ] || fail "the session that never taps should still be racing, not finished (mode $IM)"
+    [ "$TZ" -gt "$IZ" ] || fail "tapping should get further than coasting"
+    note "tier ordering ok - the idle session is still racing, the tapping one finished"
+
+    # --- 4) record -> replay ----------------------------------------------
+    "$CLI" run "$GAME" --frames 700 --input "$TAP" --record "$OUT/rec.txt" --quiet > /dev/null 2>&1
+    "$CLI" run "$GAME" --frames 700 --input "$OUT/rec.txt" --syms "$SYMS" --vars pz,mode > "$OUT/re.txt" 2>/dev/null
+    "$CLI" run "$GAME" --frames 700 --input "$TAP" --syms "$SYMS" --vars pz,mode > "$OUT/main.f0" 2>/dev/null
+    grep '^frame ' "$OUT/main.f0" > "$OUT/main.f"
+    grep '^frame ' "$OUT/re.txt"  > "$OUT/re.f"
+    cmp -s "$OUT/main.f" "$OUT/re.f" || fail "the recorded session does not replay bit-identically"
+    note "record->replay ok"
+else
+    note "named variables skipped - no tapracer.syms and no riscv nm to make one"
+fi
+
+# --- 5) instruction budget: heaviest sampled frame under half the cap ------
+MAX=0
+for f in 100 300 600 900 1200 1600; do
+    N=$("$CLI" inspect "$GAME" --frames $f --input "$TAP" 2>/dev/null | awk '$1=="INSTRET_FRAME"{print $2}')
+    [ -n "$N" ] || fail "inspect gave no INSTRET_FRAME at frame $f"
+    [ "$N" -gt "$MAX" ] && MAX=$N
+done
+[ "$MAX" -lt 500000 ] || fail "a frame retired $MAX instructions (budget 500000 of the 1000000 cap)"
+note "budget ok - heaviest sampled frame $MAX instructions"
+
+echo "test-tapracer: tapracer ok (determinism, story, tier ordering, record-replay, budget)"
