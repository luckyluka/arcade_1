+    }
+    if (mode >= 1) car_shape(SCRW / 2, SCRH - 30, 38, 0, 255, lean, boost > 0, sp);
+    /* HUD */
+    char b[26]; int k;
+    text_at(6, 4, "SPEED", 8, 200); text_at(6, 14, "TAP", 8, 170); text_at(6, 24, "PWR", 8, 170);
