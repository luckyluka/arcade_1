+    k = 0; b[k++] = 'T'; b[k++] = 'I'; b[k++] = 'M'; b[k++] = 'E'; b[k++] = ' '; { int t = (mode == 3 ? fin : tframe); k += put_num(b + k, t / 60, 1); b[k++] = '.'; b[k++] = (char)('0' + (t % 60) * 10 / 60); } b[k] = 0; text_at(SCRW - 86, 14, b, 8, 200);
