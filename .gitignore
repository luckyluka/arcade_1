# Build output
arcade1_libretro.so
arcade1_libretro_android_*.so
*.o
*.a

# Guest program build artifacts (built from programs/*.c by the RISC-V GCC)
programs/build/

# Test executables (built by the make test-* targets)
/build/

# Python bytecode left by running tools/*.py in tests
__pycache__/
*.pyc

# Editor / OS noise
*.swp
*~
.DS_Store

# Generated captures and previews. The PNG writer used to store its image
# data uncompressed, so one 1080p capture was 6.2 MB and the repo carried
# four of them. The sources stay; the captures do not — regenerate them
# with `arcade1 run ... --capture frame.png` (compressed now, ~100x
# smaller) or `make capture-*`.
captures/
round*/smoke.png
round*/final*.png
round*/out.png

# Art reference sheets: the owner's image-model output, kept OUT of the
# repository (licence and visibility are the owner's decision — see
# docs/art/REFERENCES.md). The files live outside the working tree; they
# remain in the git history.
round*/Firefly_*.jpg
Firefly_*.jpg
