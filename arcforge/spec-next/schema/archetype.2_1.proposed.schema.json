{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcade1.local/arcforge/spec-next/archetype.2_1.proposed.schema.json",
  "title": "ArcForge Archetype (v2.1, PROPOSED)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archetype",
    "version",
    "description",
    "view",
    "params",
    "layers",
    "parts",
    "anchors",
    "animations",
    "size",
    "classes",
    "metrics",
    "min_cell"
  ],
  "properties": {
    "archetype": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "view": {
      "enum": [
        "front",
        "side",
        "top"
      ]
    },
    "canvas": {
      "type": "object"
    },
    "params": {
      "type": "object"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "shapes"
        ],
        "additionalProperties": false,
        "properties": {
          "shapes": {
            "type": "array"
          }
        }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "at"
        ],
        "properties": {
          "part": {
            "type": "string"
          },
          "at": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        }
      }
    },
    "animations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fps",
          "loop",
          "frames"
        ],
        "properties": {
          "fps": {
            "type": "number"
          },
          "loop": {
            "type": "boolean"
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hit_frames": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "offsets"
              ],
              "additionalProperties": false,
              "properties": {
                "offsets": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          }
        }
      }
    },
    "collision": {
      "type": "object"
    },
    "symmetric": {
      "type": "boolean"
    },
    "mirror_axis": {
      "type": "string"
    },
    "outline_override": {
      "enum": [
        "none",
        "outer"
      ]
    },
    "tileable": {
      "type": "object",
      "properties": {
        "x": {
          "type": "boolean"
        },
        "y": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min",
          "max",
          "default"
        ],
        "properties": {
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "default": {
            "type": "integer"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "max"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "max": {
            "type": "integer"
          }
        }
      }
    },
    "proportions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      }
    },
    "min_cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": [
          "integer",
          "string"
        ]
      }
    }
  }
}
