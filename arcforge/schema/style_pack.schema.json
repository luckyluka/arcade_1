{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcade1.local/arcforge/schema/style_pack.schema.json",
  "title": "ArcForge Style Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["style_pack", "version", "description", "max_colors", "outline", "ramps"],
  "properties": {
    "style_pack": { "type": "string", "format": "identifier" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "max_colors": { "type": "integer", "minimum": 2, "maximum": 256 },
    "min_feature_px": { "type": "integer", "minimum": 1, "maximum": 64,
                        "description": "Smallest filled dimension any compiled shape may have before the size sweep and every test run report W_FEATURE_TOO_SMALL. 1 = no constraint." },
    "shading": {
      "type": "object",
      "description": "Volume shading for shapes filled 'ramp.*': integer light vector (~unit*1024) and optional 2x2 Bayer dither.",
      "additionalProperties": false,
      "properties": {
        "light": { "type": "array", "items": { "type": "integer", "minimum": -1024, "maximum": 1024 }, "minItems": 3, "maxItems": 3 },
        "dither": { "enum": ["none", "bayer2"] }
      }
    },
    "outline": { "type": "object", "additionalProperties": false, "required": ["mode", "ramp"],
      "properties": {
        "mode": { "enum": ["none", "outer"] },
        "ramp": { "type": "string" },
        "separate_layers": { "type": "array", "items": { "type": "string" } },
        "inner": {
          "type": "object",
          "description": "Per-part inner outline: a 1px outline INSIDE the silhouette, on part boundaries.",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["none", "part"] },
            "parts": { "type": "array", "items": { "type": "string" }, "minItems": 1,
                       "description": "Restrict the line to these part names; omitted = every part." }
          } }
      } },
    "ramps": { "type": "object", "additionalProperties": { "type": "object",
      "propertyNames": { "enum": ["deep", "shadow", "base", "light", "high"] },
      "additionalProperties": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 3, "maxItems": 3 },
      "required": ["base"] } }
  }
}
