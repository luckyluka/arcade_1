{
  "archetype": "t_repeat_bound",
  "version": "1.0.0",
  "description": "Negative fixture: repeat count 9 exceeds its declared max 4 (E_REPEAT_BOUND).",
  "view": "front",
  "canvas": { "default": [8, 8], "supported": [[8, 8]] },
  "params": {},
  "layers": ["body"],
  "parts": {
    "root": {
      "shapes": [
        { "shape": "repeat", "var": "k", "count": 9, "max": 4, "step_x": 1,
          "shapes": [
            { "shape": "rect", "layer": "body", "x": 1, "y": 1, "w": 2, "h": 2, "fill": "steel.base" }
          ] }
      ]
    }
  },
  "anchors": { "origin": { "part": "root", "at": [4, 7] } },
  "animations": { "idle": { "fps": 6, "loop": true, "frames": [{ "offsets": {} }] } },
  "size": { "height": { "min": 4, "max": 8, "default": 6 } },
  "metrics": [["cx", "floor($W/2)"]],
  "min_cell": [8, 8]
}
