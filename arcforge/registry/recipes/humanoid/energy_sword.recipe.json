{
  "recipe": "energy_sword",
  "version": "1.0.0",
  "category": "humanoid/weapon",
  "description": "Hilt, guard and a glowing blade held in hand_r. Blade points up at angle 0; positive angle rotates clockwise. On size-parametric archetypes the blade follows the percent parameters reach and blade_w instead of length/thickness/angle.",
  "applies_to": ["humanoid_hero", "humanoid_front_scalable"],
  "slot": "weapon_main",
  "requires_anchors": ["hand_r"],
  "parameters": {
    "length":    { "type": "int", "min": 6, "max": 20, "default": 12, "unit": "px" },
    "thickness": { "type": "int", "min": 1, "max": 5,  "default": 3,  "unit": "px" },
    "color":     { "type": "ramp", "default": "red", "allow": ["red", "blue", "gold"] },
    "glow":      { "type": "enum", "values": ["none", "weak", "strong"], "default": "strong" },
    "angle":     { "type": "int", "min": -60, "max": 60, "default": 0, "unit": "deg" },
    "reach":     { "type": "percent", "of": "height", "min": 20, "max": 55, "default": 45, "min_px": 4 },
    "blade_w":   { "type": "percent", "of": "height", "min": 4,  "max": 12, "default": 8,  "min_px": 1 }
  },
  "sizes": { "min": 16, "max": 64 },
  "geometry": {
    "humanoid_hero": [
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "rotate": "$angle", "x": "-floor($thickness/2)-1", "y": "-4-$length-1", "w": "$thickness+2", "h": "$length+1", "fill": "$color.shadow", "when": "$glow == 'strong'" },
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "rotate": "$angle", "x": "-floor($thickness/2)", "y": "-4-$length", "w": "$thickness", "h": "$length", "fill": "$color.base" },
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "rotate": "$angle", "x": "0", "y": "-4-$length", "w": "1", "h": "$length", "fill": "$color.light", "when": "$glow != 'none' && $thickness >= 3" },
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "rotate": "$angle", "x": -3, "y": -4, "w": 7, "h": 2, "fill": "gold.base" },
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "rotate": "$angle", "x": -1, "y": -2, "w": 3, "h": 3, "fill": "$armor_ramp.shadow" }
    ],
    "humanoid_front_scalable": [
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "x": "-half($blade_w) - 1", "y": "-max(2, $u + 1) - max(1, $u) - $reach", "w": "2 * half($blade_w) + 3", "h": "$reach + 1", "fill": "$color.shadow", "when": "$glow == 'strong'" },
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "x": "-half($blade_w)", "y": "1 - max(2, $u + 1) - max(1, $u) - $reach", "w": "2 * half($blade_w) + 1", "h": "$reach", "fill": "$color.base" },
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "x": "0", "y": "1 - max(2, $u + 1) - max(1, $u) - $reach", "w": "1", "h": "$reach", "fill": "$color.light", "when": "$glow != 'none' && 2 * half($blade_w) + 1 >= 3" },
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "x": "-half(2 * half($blade_w) + 1 + 2 * max(1, $u))", "y": "1 - max(2, $u + 1) - max(1, $u)", "w": "2 * half($blade_w) + 1 + 2 * max(1, $u)", "h": "max(1, $u)", "fill": "gold.base" },
      { "anchor": "hand_r", "layer": "held", "shape": "rect", "x": "-half($u)", "y": "1 - max(2, $u + 1)", "w": "2 * half($u) + 1", "h": "max(2, $u + 1)", "fill": "$armor_ramp.shadow" }
    ]
  },
  "hitboxes": [
    { "id": "sword", "anchor": "hand_r", "rect": ["-floor($thickness/2)", "-4-$length", "$thickness", "$length"], "active_in": ["attack"] }
  ],
  "examples": [ {}, { "length": 20, "thickness": 5, "color": "blue", "glow": "none", "angle": 30 }, { "length": 6, "thickness": 1, "angle": -60 } ]
}
