{
  "recipe": "shield_round",
  "version": "1.0.0",
  "category": "humanoid/defense",
  "description": "Round shield carried on the left hand with a central boss.",
  "applies_to": [
    "humanoid_hero"
  ],
  "slot": "shield_off",
  "requires_anchors": [
    "hand_l"
  ],
  "parameters": {
    "size": {
      "type": "int",
      "min": 7,
      "max": 11,
      "default": 9
    },
    "color": {
      "type": "ramp",
      "default": "blue",
      "allow": [
        "red",
        "blue",
        "gold"
      ]
    }
  },
  "geometry": [
    {
      "anchor": "hand_l",
      "layer": "held",
      "shape": "ellipse",
      "x": "- $size//2",
      "y": "- $size//2",
      "w": "$size",
      "h": "$size",
      "fill": "$color.base"
    },
    {
      "anchor": "hand_l",
      "layer": "held",
      "shape": "ellipse",
      "x": "- $size//2+1",
      "y": "- $size//2+1",
      "w": "$size-2",
      "h": "$size-2",
      "fill": "$color.shadow"
    },
    {
      "anchor": "hand_l",
      "layer": "held",
      "shape": "rect",
      "x": -1,
      "y": -1,
      "w": 2,
      "h": 2,
      "fill": "gold.light"
    }
  ],
  "examples": [
    {},
    {
      "size": 11,
      "color": "red"
    }
  ]
}
